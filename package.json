{
  "name": "inventory-ui",
  "version": "0.2.0",
  "description": "Fast inventory screen for items and stock positions: search, add, move, use up.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build:dev": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs dev-once",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^8.67.0",
    "chokidar": "^3.6.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "latest",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "uqr": "^0.1.3"
  }
}
